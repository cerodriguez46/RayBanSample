name: Project Code Linting

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  lint:
    name: Code Workspace Lint Checks
    runs-on: ubuntu-latest # Runs instantly on free, lightweight Linux machines

    steps:
      - name: Checkout Repository Source Code
        uses: actions/checkout@v4

      - name: Check for Unresolved Merge Conflicts or Hardcoded Tokens
        run: |
          echo "Scanning workspace layout container for system validation checks..."
          # Scans files for common Git merge conflict strings left behind by accident
          if grep -qE "<<<<<<<|=======>|>>>>>>>" $(find . -type f -not -path '*/.*' -not -path '*/docs/*'); then
            echo "❌ CRITICAL LINT FAILURE: Unresolved Git merge markers detected in workspace files!"
            exit 1
          else
            echo "✅ Lint Verification Passed: Workspace files are completely clean of conflict blocks."
          fi

      - name: Check file structures for trailing whitespace
        run: |
          # Checks files to make sure they do not have messy empty lines or trailing spaces
          echo "Evaluating trailing space validations across project structures..."

